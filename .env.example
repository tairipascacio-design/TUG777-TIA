# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional BYO-AI (OpenAI-compatible: DeepSeek, OpenRouter, Ollama, vLLM)
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_MODEL=""
CUSTOM_AI_API_KEY=""

# Google Cloud Run 24/7 tug777-engine + Montana Cloud (mcloud)
PORT="8080"
HL_NETWORK="mainnet"
HL_MASTER_ADDRESS=""
# Optional: only configure on private backend environment, never expose in client bundles
HL_API_PRIVATE_KEY=""
ENGINE_AUTH_TOKEN=""
MCLOUD_URL="https://mcloud-1036926196544.us-east1.run.app"
MCLOUD_API_KEY=""
MCLOUD_SECRET=""
TUG777_ENGINE_TOKEN="TUG777_ENGINE"
